<?xml version="1.0" encoding="utf-8"?>
<!-- OS auto-backup is excluded, matching iOS, until a policy is decided. Users export backups manually. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
